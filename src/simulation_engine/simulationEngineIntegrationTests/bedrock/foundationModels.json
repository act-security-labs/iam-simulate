  {
    "name": "regionless model allowed by exact identity policy",
    "simulation": {
      "identityPolicies": [
        {
          "name": "model-access",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "bedrock:InvokeModel",
                "Resource": "arn:aws:bedrock:::foundation-model/example.model-v1:0"
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": null,
      "request": {
        "action": "bedrock:InvokeModel",
        "resource": {
          "resource": "arn:aws:bedrock:::foundation-model/example.model-v1:0",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:role/TestRole",
        "contextVariables": {}
      }
    },
    "expected": {
      "resultType": "single",
      "overallResult": "Allowed",
      "results": []
    }
  },
