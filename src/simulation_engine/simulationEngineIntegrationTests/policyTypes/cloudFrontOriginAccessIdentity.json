[
  {
    "name": "OAI discovery preserves the escape condition for an unknown conditional deny",
    "simulation": {
      "request": {
        "principal": "arn:aws:iam::cloudfront:user/CloudFront Origin Access Identity E123",
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::example-bucket/object",
          "accountId": "222222222222"
        },
        "contextVariables": { "aws:PrincipalType": "unknown" }
      },
      "identityPolicies": [],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::example-bucket/*"
          },
          {
            "Sid": "ConditionalDeny",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::example-bucket/*",
            "Condition": { "StringEquals": { "aws:PrincipalType": "User" } }
          }
        ]
      }
    },
    "simulationOptions": {
      "simulationMode": "Discovery",
      "discoveryContextKeyConstraints": [
        { "keyName": "aws:PrincipalType", "presenceIsKnown": true, "valueIsKnown": false }
      ]
    },
    "expected": {
      "resultType": "single",
      "overallResult": "Allowed",
      "results": [
        {
          "conditions": {
            "conditionType": "condition",
            "op": "StringNotEquals",
            "key": "aws:PrincipalType",
            "values": ["User"],
            "sources": [
              {
                "policyType": "resource",
                "effect": "Deny",
                "statementId": "ConditionalDeny",
                "statementIndex": 2
              }
            ],
            "inverted": true
          }
        }
      ]
    }
  },
