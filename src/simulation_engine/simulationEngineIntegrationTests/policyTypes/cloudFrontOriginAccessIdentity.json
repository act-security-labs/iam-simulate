  {
    "name": "OAI is excluded by CloudFront service NotPrincipal",
    "simulation": {
      "request": {
        "principal": "arn:aws:iam::cloudfront:user/CloudFront Origin Access Identity E123",
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::example-bucket/object",
          "accountId": "222222222222"
        },
        "contextVariables": {}
      },
      "identityPolicies": [],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::cloudfront:user/CloudFront Origin Access Identity E123"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::example-bucket/*"
          },
          {
            "Effect": "Deny",
            "NotPrincipal": { "Service": "cloudfront.amazonaws.com" },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::example-bucket/*"
          }
        ]
      }
    },
    "expected": { "resultType": "single", "overallResult": "Allowed", "results": [] }
  },
