[
  {
    "name": "duplicate deny candidates are deduplicated and unrelated denies are excluded",
    "simulation": {
      "identityPolicies": [
        {
          "name": "identity-allow",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/*"
              },
              {
                "Effect": "Deny",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/identity/*"
              },
              {
                "Effect": "Deny",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/identity/*"
              },
              {
                "Effect": "Deny",
                "Action": "s3:PutObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/other-action/*"
              },
              {
                "Effect": "Deny",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/unrelated/*"
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "request": {
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::examplebucket/reports/*",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:role/Reader",
        "contextVariables": {}
      }
    },
    "simulationOptions": {},
    "expected": {
      "resultType": "wildcard",
      "overallResult": "Allowed",
      "results": [
        {
          "resourceType": "object",
          "resourcePattern": "arn:aws:s3:::examplebucket/reports/*",
          "result": "Allowed"
        },
        {
          "resourceType": "object",
          "resourcePattern": "arn:aws:s3:::examplebucket/reports/identity/*",
          "result": "ExplicitlyDenied"
        }
      ]
    }
  }
]
