[
  {
    "name": "wildcard includes a child denied by session policy",
    "simulation": {
      "identityPolicies": [
        {
          "name": "identity-allow",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/*"
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "request": {
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::examplebucket/reports/*",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:role/Reader",
        "contextVariables": {}
      },
      "sessionPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::examplebucket/reports/*"
          },
          {
            "Effect": "Deny",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::examplebucket/reports/session/*"
          }
        ]
      }
    },
    "simulationOptions": {},
    "expected": {
      "resultType": "wildcard",
      "overallResult": "Allowed",
      "results": [
        {
          "resourceType": "object",
          "resourcePattern": "arn:aws:s3:::examplebucket/reports/*",
          "result": "Allowed"
        },
        {
          "resourceType": "object",
          "resourcePattern": "arn:aws:s3:::examplebucket/reports/session/*",
          "result": "ExplicitlyDenied"
        }
      ]
    }
  },
  {
    "name": "session conditional deny candidate with blocked context",
