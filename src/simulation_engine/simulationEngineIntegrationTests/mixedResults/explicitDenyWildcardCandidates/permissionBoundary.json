          "resource": "arn:aws:s3:::examplebucket/reports/*",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:role/Reader",
        "contextVariables": {
          "aws:PrincipalTag/team": "blocked"
        }
      },
      "permissionBoundaryPolicies": [
        {
          "name": "boundary",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/*"
              },
              {
                "Effect": "Deny",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/reports/boundary/*",
                "Condition": {
                  "StringEquals": {
                    "aws:PrincipalTag/team": "blocked"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "simulationOptions": {},
    "expected": {
      "resultType": "wildcard",
