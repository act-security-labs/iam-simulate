[
  {
    "name": "AWS managed alias delete is service denied despite an explicit SCP deny",
    "simulation": {
      "request": {
        "principal": "arn:aws:iam::123456789012:role/caller",
        "action": "kms:DeleteAlias",
        "resource": {
          "resource": "arn:aws:kms:us-east-1:123456789012:alias/aws/s3",
          "accountId": "123456789012"
        },
        "contextVariables": {}
      },
      "identityPolicies": [
        {
          "name": "Grant",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [{ "Effect": "Allow", "Action": "kms:DeleteAlias", "Resource": "*" }]
          }
        }
      ],
      "serviceControlPolicies": [
        {
          "orgIdentifier": "ou-example",
          "policies": [
            {
              "name": "SCP",
              "policy": {
                "Version": "2012-10-17",
                "Statement": [{ "Effect": "Deny", "Action": "kms:DeleteAlias", "Resource": "*" }]
              }
            }
          ]
        }
      ],
      "resourceControlPolicies": []
    },
    "expected": {
      "resultType": "single",
      "overallResult": "ImplicitlyDenied",
      "results": [{}],
      "analysis": {
        "blockedBy": null,
        "identityResult": "Allowed",
        "scpResult": "ExplicitlyDenied"
      }
    }
  },
  {
