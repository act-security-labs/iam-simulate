        "resource": {
          "resource": "arn:aws:kms:us-east-1:123456789012:alias/customer",
          "accountId": "123456789012"
        },
        "contextVariables": {}
      },
      "identityPolicies": [
        {
          "name": "Grant",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [{ "Effect": "Allow", "Action": "kms:DeleteAlias", "Resource": "*" }]
          }
        }
      ],
      "serviceControlPolicies": [
        {
          "orgIdentifier": "ou-example",
          "policies": [
            {
              "name": "SCP",
              "policy": {
                "Version": "2012-10-17",
                "Statement": [{ "Effect": "Deny", "Action": "kms:DeleteAlias", "Resource": "*" }]
              }
