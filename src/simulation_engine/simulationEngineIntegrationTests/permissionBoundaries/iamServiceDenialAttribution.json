[
  {
    "name": "reserved role PassRole retains boundary analysis without guardrail attribution",
    "simulation": {
      "request": {
        "principal": "arn:aws:iam::123456789012:role/caller",
        "action": "iam:PassRole",
        "resource": {
          "resource": "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_Example_123",
          "accountId": "123456789012"
        },
        "contextVariables": {}
      },
      "identityPolicies": [
        {
          "name": "Grant",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [{ "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*" }]
          }
        }
      ],
      "permissionBoundaryPolicies": [
        {
          "name": "Boundary",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [{ "Effect": "Allow", "Action": "iam:GetRole", "Resource": "*" }]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": []
    },
    "expected": {
      "resultType": "single",
      "overallResult": "ImplicitlyDenied",
      "results": [{}],
      "analysis": {
        "blockedBy": null,
        "identityResult": "Allowed",
        "permissionBoundaryResult": "ImplicitlyDenied",
        "denials": [{ "policyType": "pb", "denialType": "Implicit" }]
      }
    }
  },
