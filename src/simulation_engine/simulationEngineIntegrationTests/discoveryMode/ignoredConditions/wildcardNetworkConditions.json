  {
    "name": "wildcard request combines candidate allow and request-scoped deny conditions without duplicating exact conditions",
    "simulation": {
      "identityPolicies": [
        {
          "name": "ConditionalFullS3",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:*",
                "Resource": "*",
                "Condition": {
                  "StringEquals": {
                    "aws:PrincipalTag/team": "blue"
                  }
                }
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::demo-bucket/*",
            "Condition": {
              "StringNotEquals": {
                "aws:SourceVpc": "vpc-allowed"
              }
            }
          }
        ]
      },
      "request": {
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::demo-bucket/*",
          "accountId": "111111111111"
        },
        "principal": "arn:aws:iam::111111111111:role/Reader",
        "contextVariables": {}
      }
    },
    "simulationOptions": {
      "simulationMode": "Discovery"
    },
    "expected": {
      "resultType": "wildcard",
      "overallResult": "Allowed",
      "results": [
        {
          "resourceType": "object",
          "resourcePattern": "*",
          "result": "Allowed",
          "conditions": {
            "conditionType": "group",
            "operator": "and",
            "conditions": [
              {
                "conditionType": "condition",
                "op": "StringEquals",
                "key": "aws:PrincipalTag/team",
                "values": ["blue"],
                "sources": [
                  {
                    "policyType": "identity",
                    "effect": "Allow",
                    "statementIndex": 1,
                    "policyIdentifier": "ConditionalFullS3"
                  }
                ]
              },
              {
                "conditionType": "condition",
                "op": "StringEquals",
                "key": "aws:SourceVpc",
                "values": ["vpc-allowed"],
                "sources": [
                  {
                    "policyType": "resource",
                    "effect": "Deny",
                    "statementIndex": 1
                  }
                ],
                "inverted": true
              }
            ]
          }
        }
      ]
    }
  },
