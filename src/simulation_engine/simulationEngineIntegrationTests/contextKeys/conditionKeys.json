[
  {
    "name": "context key allows access when condition matches",
    "simulation": {
      "identityPolicies": [
        {
          "name": "conditional-allow",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/conditional/*",
                "Condition": {
                  "StringEquals": {
                    "s3:ResourceAccount": "123456789012"
                  }
                }
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": null,
      "request": {
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::examplebucket/*",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:user/Alice",
        "contextVariables": {
          "s3:ResourceAccount": "123456789012"
        }
      }
    },
    "simulationOptions": {},
    "expected": {
      "results": [
        {
          "resourceType": "object",
          "resourcePattern": "arn:aws:s3:::examplebucket/conditional/*",
          "result": "Allowed"
        }
      ],
      "overallResult": "Allowed",
      "resultType": "wildcard"
    }
  },
  {
    "name": "context key denies access when condition fails",
    "simulation": {
      "identityPolicies": [
        {
          "name": "conditional-allow",
          "policy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::examplebucket/conditional/*",
                "Condition": {
                  "StringEquals": {
                    "s3:ResourceAccount": "123456789012"
                  }
                }
              }
            ]
          }
        }
      ],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "resourcePolicy": null,
      "request": {
        "action": "s3:GetObject",
        "resource": {
          "resource": "arn:aws:s3:::examplebucket/*",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:user/Alice",
        "contextVariables": {
          "s3:ResourceAccount": "000000000000"
        }
      }
    },
    "simulationOptions": {},
    "expected": {
      "results": [],
      "overallResult": "ImplicitlyDenied",
      "resultType": "wildcard"
    }
  },
  {
    "name": "a supplied value fills a templated condition key: kms:EncryptionContext on kms:Encrypt",
    "simulation": {
      "identityPolicies": [],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "request": {
        "action": "kms:Encrypt",
        "resource": {
          "resource": "arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:user/Alice",
        "contextVariables": {
          "kms:EncryptionContext:aws:ecr:arn": "arn:aws:ecr:us-east-1:123456789012:repository/example"
        }
      },
      "resourcePolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:root"
            },
            "Action": "kms:*",
            "Resource": "*"
          },
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:user/Alice"
            },
            "Action": "kms:Encrypt",
            "Resource": "*",
            "Condition": {
              "StringLike": {
                "kms:EncryptionContext:aws:ecr:arn": "arn:aws:ecr:us-east-1:123456789012:repository/example"
              }
            }
          }
        ]
      }
    },
    "simulationOptions": {},
    "expected": {
      "resultType": "single",
      "overallResult": "Allowed",
      "results": [{}]
    }
  },
  {
    "name": "a supplied value for a key under a templated OIDC provider is ignored, not an error: token.actions.githubusercontent.com:sub",
    "simulation": {
      "identityPolicies": [],
      "serviceControlPolicies": [],
      "resourceControlPolicies": [],
      "request": {
        "action": "sts:AssumeRoleWithWebIdentity",
        "resource": {
          "resource": "arn:aws:iam::123456789012:role/web-role",
          "accountId": "123456789012"
        },
        "principal": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com",
        "contextVariables": {
          "token.actions.githubusercontent.com:sub": "repo:org/repo:ref:refs/heads/main"
        }
      },
      "resourcePolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity"
          }
        ]
      }
    },
    "simulationOptions": {
      "simulationMode": "Strict"
    },
    "expected": {
      "resultType": "single",
      "overallResult": "Allowed",
      "results": [{}]
    }
  }
]
