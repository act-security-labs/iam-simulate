[
  {
    "name": "Allowed when RCP has ignored Deny Condition",
    "request": {
      "action": "s3:ListAllMyBuckets",
      "resource": {
        "resource": "*",
        "accountId": "123456789012"
      },
      "principal": "arn:aws:iam::123456789012:user/test-user",
      "context": {
        "aws:Username": "test-user"
      }
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourceControlPolicies": [
      {
        "orgIdentifier": "ou-1",
        "policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*",
                "Principal": "*"
              }
            ]
          },
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Deny",
                "Action": "s3:ListAllMyBuckets",
                "Resource": "*",
                "Principal": "*",
                "Condition": {
                  "StringEquals": {
                    "aws:Username": "test-user"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery"
    },
    "expected": {
      "response": "Allowed",
      "ignoredConditions": {
        "rcp": {
          "deny": [
            {
              "key": "aws:Username",
              "op": "StringEquals",
              "values": ["test-user"]
            }
          ]
        }
      },
      "conditions": {
        "conditionType": "condition",
        "op": "StringNotEquals",
        "key": "aws:Username",
        "values": ["test-user"],
        "sources": [
          {
            "effect": "Deny",
            "policyIdentifier": "0",
            "policyType": "rcp",
            "statementIndex": 1,
            "orgIdentifier": "ou-1"
          }
        ],
        "inverted": true
      }
    }
  },
  {
    "name": "Block when RCP has strict match Deny Condition",
    "request": {
      "action": "s3:ListAllMyBuckets",
      "resource": {
        "resource": "*",
        "accountId": "123456789012"
      },
      "principal": "arn:aws:iam::123456789012:user/test-user",
      "context": {
        "aws:Username": "test-user"
      }
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourceControlPolicies": [
      {
        "orgIdentifier": "ou-1",
        "policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Principal": "*",
                "Resource": "*"
              }
            ]
          },
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Deny",
                "Action": "s3:ListAllMyBuckets",
                "Resource": "*",
                "Principal": "*",
                "Condition": {
                  "StringEquals": {
                    "aws:Username": "test-user"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery",
      "discoveryContextKeyConstraints": [
        {
          "keyName": "aws:username",
          "presenceIsKnown": true,
          "valueIsKnown": true
        }
      ]
    },
    "expected": {
      "response": "ExplicitlyDenied",
      "blockedBy": ["rcp"]
    }
  },
  {
    "name": "Do Not Report Ignored Conditions When Other Deny Parts Do Not Match",
    "request": {
      "action": "s3:ListAllMyBuckets",
      "resource": {
        "resource": "*",
        "accountId": "123456789012"
      },
      "principal": "arn:aws:iam::123456789012:user/test-user",
      "context": {
        "aws:Username": "test-user"
      }
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourceControlPolicies": [
      {
        "orgIdentifier": "ou-1",
        "policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*"
              }
            ]
          },
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Deny",
                "Action": "sts:AssumeRole",
                "Resource": "*",
                "Principal": "*",
                "Condition": {
                  "StringEquals": {
                    "aws:Username": "test-user"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery"
    },
    "expected": {
      "response": "Allowed"
    }
  },
  {
    "name": "Allowed with RCP VPC deny escape conditions when SourceVpc has no context key knowledge",
    "request": {
      "action": "s3:GetObject",
      "resource": {
        "resource": "arn:aws:s3:::tier-4-vpc-access/object.txt",
        "accountId": "111111111111"
      },
      "principal": "arn:aws:iam::111111111111:user/test-user",
      "context": {}
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::tier-4-vpc-access/*"
          }
        ]
      }
    ],
    "resourceControlPolicies": [
      {
        "orgIdentifier": "ou-1",
        "policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "DenyTier4OutsideAccessVpc",
                "Effect": "Deny",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": ["arn:aws:s3:::tier-4-vpc-access", "arn:aws:s3:::tier-4-vpc-access/*"],
                "Condition": {
                  "Null": {
                    "aws:SourceVpc": "false"
                  },
                  "StringNotEquals": {
                    "aws:SourceVpc": "vpc-00000000000000"
                  },
                  "BoolIfExists": {
                    "aws:PrincipalIsAWSService": "false"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery"
    },
    "expected": {
      "response": "Allowed",
      "ignoredConditions": {
        "rcp": {
          "deny": [
            {
              "key": "aws:SourceVpc",
              "op": "Null",
              "values": ["false"]
            },
            {
              "key": "aws:SourceVpc",
              "op": "StringNotEquals",
              "values": ["vpc-00000000000000"]
            },
            {
              "key": "aws:PrincipalIsAWSService",
              "op": "BoolIfExists",
              "values": ["false"]
            }
          ]
        }
      },
      "conditions": {
        "conditionType": "group",
        "operator": "or",
        "conditions": [
          {
            "conditionType": "condition",
            "op": "Null",
            "key": "aws:SourceVpc",
            "values": ["true"],
            "sources": [
              {
                "effect": "Deny",
                "policyIdentifier": "0",
                "policyType": "rcp",
                "statementIndex": 1,
                "orgIdentifier": "ou-1",
                "statementId": "DenyTier4OutsideAccessVpc"
              }
            ],
            "inverted": true
          },
          {
            "conditionType": "condition",
            "op": "StringEquals",
            "key": "aws:SourceVpc",
            "values": ["vpc-00000000000000"],
            "sources": [
              {
                "effect": "Deny",
                "policyIdentifier": "0",
                "policyType": "rcp",
                "statementIndex": 1,
                "orgIdentifier": "ou-1",
                "statementId": "DenyTier4OutsideAccessVpc"
              }
            ],
            "inverted": true
          },
          {
            "conditionType": "group",
            "operator": "and",
            "conditions": [
              {
                "conditionType": "condition",
                "op": "Null",
                "key": "aws:PrincipalIsAWSService",
                "values": ["false"],
                "sources": [
                  {
                    "effect": "Deny",
                    "policyIdentifier": "0",
                    "policyType": "rcp",
                    "statementIndex": 1,
                    "orgIdentifier": "ou-1",
                    "statementId": "DenyTier4OutsideAccessVpc"
                  }
                ],
                "inverted": true
              },
              {
                "conditionType": "condition",
                "op": "Bool",
                "key": "aws:PrincipalIsAWSService",
                "values": ["true"],
                "sources": [
                  {
                    "effect": "Deny",
                    "policyIdentifier": "0",
                    "policyType": "rcp",
                    "statementIndex": 1,
                    "orgIdentifier": "ou-1",
                    "statementId": "DenyTier4OutsideAccessVpc"
                  }
                ],
                "inverted": true
              }
            ]
          }
        ]
      }
    }
  }
]
