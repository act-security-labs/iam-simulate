              "values": ["111111111111"]
            }
          ]
        }
      },
      "conditions": {
        "conditionType": "condition",
        "op": "StringNotEquals",
        "key": "s3:ResourceAccount",
        "values": ["111111111111"],
        "sources": [
          {
            "effect": "Allow",
            "policyIdentifier": "0",
            "policyType": "identity",
            "statementIndex": 1
          }
        ]
      }
    }
