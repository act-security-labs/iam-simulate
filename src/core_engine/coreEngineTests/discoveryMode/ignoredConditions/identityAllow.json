[
  {
    "name": "Allowed when identity has conditions being ignored",
    "request": {
      "action": "s3:ListBucket",
      "resource": {
        "resource": "*",
        "accountId": "123456789012"
      },
      "principal": "arn:aws:iam::123456789012:user/test-user",
      "context": {
        "aws:Username": "test-user"
      }
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "*",
            "Condition": {
              "StringEquals": {
                "aws:SourceVpc": "vpc-123456"
              }
            }
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery"
    },
    "expected": {
      "response": "Allowed",
      "ignoredConditions": {
        "identity": {
          "allow": [
            {
              "key": "aws:SourceVpc",
              "op": "StringEquals",
              "values": ["vpc-123456"]
            }
          ]
        }
      },
      "conditions": {
        "conditionType": "condition",
        "op": "StringEquals",
        "key": "aws:SourceVpc",
        "values": ["vpc-123456"],
        "sources": [
          {
            "effect": "Allow",
            "policyIdentifier": "0",
            "policyType": "identity",
            "statementIndex": 1
          }
        ]
      }
    }
  },
  {
    "name": "Does not report ignored conditions when the statement does not apply",
    "request": {
      "action": "s3:ListBucket",
      "resource": {
        "resource": "arn:aws:s3:::example-bucket",
        "accountId": "123456789012"
      },
      "principal": "arn:aws:iam::123456789012:user/test-user",
      "context": {
        "aws:Username": "test-user"
      }
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "NotResource": "arn:aws:s3:::example-bucket",
            "Condition": {
              "StringEquals": {
                "aws:SourceVpc": "vpc-123456"
              }
            }
          }
        ]
      }
    ],
    "simulation": {
      "mode": "Discovery"
    },
    "expected": {
      "response": "ImplicitlyDenied"
    }
  },
  {
    "name": "Allowed with condition when identity Allow negative condition key is unconstrained and absent",
