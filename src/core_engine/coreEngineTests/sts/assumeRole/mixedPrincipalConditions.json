[
  {
    "name": "mixed account and assumed-role session principals preserve the unconditional trust path",
    "request": {
      "action": "sts:AssumeRole",
      "resource": {
        "resource": "arn:aws:iam::111111111111:role/TargetRole",
        "accountId": "111111111111"
      },
      "principal": "arn:aws:iam::111111111111:role/AdminRole",
      "context": {}
    },
    "simulation": {
      "mode": "Discovery"
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "sts:AssumeRole",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "MixedAccountAndSessionPrincipal",
          "Effect": "Allow",
          "Principal": {
            "AWS": [
              "arn:aws:iam::111111111111:root",
              "arn:aws:sts::111111111111:assumed-role/AdminRole/named-session"
            ]
          },
          "Action": "sts:AssumeRole",
          "Resource": "*"
        }
      ]
    },
    "expected": {
      "response": "Allowed",
      "ignoredRoleSessionName": true
    }
  },
  {
