    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "SessionOnly",
          "Effect": "Allow",
          "Principal": {
            "AWS": "arn:aws:sts::111111111111:assumed-role/AdminRole/named-session"
          },
