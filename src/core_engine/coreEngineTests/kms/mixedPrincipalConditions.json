  {
    "name": "statement conditions apply to both mixed principal paths while the session name stays direct-only",
    "request": {
      "action": "kms:DescribeKey",
      "resource": {
        "resource": "arn:aws:kms:us-east-1:111111111111:key/example",
        "accountId": "111111111111"
      },
      "principal": "arn:aws:iam::111111111111:role/AdminRole",
      "context": {
        "kms:ViaService": "s3.us-east-1.amazonaws.com"
      }
    },
    "simulation": {
      "mode": "Discovery",
      "discoveryContextKeyConstraints": [
        {
          "keyName": "kms:ViaService",
          "presenceIsKnown": true,
          "valueIsKnown": false
        }
      ]
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "kms:DescribeKey",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "MixedAccountAndSessionPrincipalWithViaService",
          "Effect": "Allow",
          "Principal": {
            "AWS": [
              "arn:aws:iam::111111111111:root",
              "arn:aws:sts::111111111111:assumed-role/AdminRole/named-session"
            ]
          },
          "Action": "kms:*",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:ViaService": "ec2.us-east-1.amazonaws.com"
            }
          }
        }
      ]
    },
    "expected": {
      "response": "Allowed",
      "ignoredRoleSessionName": true,
      "conditions": {
        "conditionType": "condition",
        "op": "StringEquals",
        "key": "kms:ViaService",
        "values": ["ec2.us-east-1.amazonaws.com"],
        "sources": [
          {
            "policyType": "resource",
            "effect": "Allow",
            "policyIdentifier": "ResourcePolicy",
            "statementId": "MixedAccountAndSessionPrincipalWithViaService",
            "statementIndex": 1
          }
        ]
      },
      "ignoredConditions": {
        "resource": {
          "allow": [
            {
              "key": "kms:ViaService",
              "op": "StringEquals",
              "values": ["ec2.us-east-1.amazonaws.com"]
            }
          ]
        }
      }
    }
  },
  {
    "name": "unconditional direct role statement absorbs a conditional same-account trust statement",
    "request": {
      "action": "kms:DescribeKey",
      "resource": {
        "resource": "arn:aws:kms:us-east-1:111111111111:key/example",
        "accountId": "111111111111"
      },
      "principal": "arn:aws:iam::111111111111:role/AdminRole",
      "context": {
        "kms:ViaService": "placeholder.us-east-1.amazonaws.com"
      }
    },
    "simulation": {
      "mode": "Discovery",
      "discoveryContextKeyConstraints": [
        {
          "keyName": "kms:ViaService",
          "presenceIsKnown": true,
          "valueIsKnown": false
        }
      ]
    },
    "identityPolicies": [],
    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "DirectRoleAccess",
          "Effect": "Allow",
          "Principal": {
            "AWS": "arn:aws:iam::111111111111:role/AdminRole"
          },
          "Action": "kms:DescribeKey",
          "Resource": "*"
        },
        {
          "Sid": "ConditionalAccountTrust",
          "Effect": "Allow",
          "Principal": {
            "AWS": "arn:aws:iam::111111111111:root"
          },
          "Action": "kms:DescribeKey",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:ViaService": "ec2.us-east-1.amazonaws.com"
            }
          }
        }
      ]
    },
    "expected": {
      "response": "Allowed",
      "ignoredConditions": {
        "resource": {
          "allow": [
            {
              "key": "kms:ViaService",
              "op": "StringEquals",
              "values": ["ec2.us-east-1.amazonaws.com"]
            }
          ]
        }
      }
    }
  },
  {
