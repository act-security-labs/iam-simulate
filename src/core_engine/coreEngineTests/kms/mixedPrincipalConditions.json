[
  {
    "name": "mixed account and assumed-role session principals preserve the unconditional KMS account-trust path",
    "request": {
      "action": "kms:DescribeKey",
      "resource": {
        "resource": "arn:aws:kms:us-east-1:111111111111:key/example",
        "accountId": "111111111111"
      },
      "principal": "arn:aws:iam::111111111111:role/AdminRole",
      "context": {}
    },
    "simulation": {
      "mode": "Discovery"
    },
    "identityPolicies": [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "kms:DescribeKey",
            "Resource": "*"
          }
        ]
      }
    ],
    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "MixedAccountAndSessionPrincipal",
          "Effect": "Allow",
          "Principal": {
            "AWS": [
              "arn:aws:iam::111111111111:root",
              "arn:aws:sts::111111111111:assumed-role/AdminRole/named-session"
            ]
          },
          "Action": "kms:DescribeKey",
          "Resource": "*"
        }
      ]
    },
    "expected": {
      "response": "Allowed",
      "ignoredRoleSessionName": true
    }
  },
