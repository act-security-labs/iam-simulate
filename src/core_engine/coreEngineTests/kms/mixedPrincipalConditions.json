            "conditionType": "group",
            "operator": "and",
            "conditions": [
              {
                "conditionType": "condition",
                "op": "StringEquals",
                "key": "kms:ViaService",
                "values": ["ec2.us-east-1.amazonaws.com"],
                "sources": [
                  {
                    "policyType": "resource",
                    "effect": "Allow",
                    "policyIdentifier": "ResourcePolicy",
                    "statementId": "MixedPrincipalWithViaService",
                    "statementIndex": 1
                  }
                ]
              },
              {
                "conditionType": "sessionName",
                "sessionName": ["named-session"],
                "sources": [
                  {
                    "policyType": "resource",
                    "effect": "Allow",
                    "policyIdentifier": "ResourcePolicy",
                    "statementId": "MixedPrincipalWithViaService",
                    "statementIndex": 1
                  }
                ]
              }
            ]
          },
          {
            "conditionType": "group",
            "operator": "and",
            "conditions": [
              {
                "conditionType": "condition",
                "op": "StringEquals",
                "key": "kms:ViaService",
                "values": ["ec2.us-east-1.amazonaws.com"],
                "sources": [
                  {
                    "policyType": "resource",
                    "effect": "Allow",
                    "policyIdentifier": "ResourcePolicy",
                    "statementId": "MixedPrincipalWithViaService",
                    "statementIndex": 1
                  }
                ]
              },
              {
                "conditionType": "condition",
                "op": "StringEquals",
                "key": "aws:SourceVpce",
                "values": ["vpce-boundary"],
